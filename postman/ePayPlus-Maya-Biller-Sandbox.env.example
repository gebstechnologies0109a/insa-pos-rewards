{
  "id": "epayplus-maya-biller-sandbox-env",
  "name": "ePayPlus Maya Biller — Sandbox",
  "values": [
    {
      "key": "base_url",
      "value": "https://your-staging-host.example.com",
      "type": "default",
      "enabled": true
    },
    {
      "key": "secret_key",
      "value": "REPLACE_WITH_MAYA_RM_SANDBOX_SECRET",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "callback_api_key",
      "value": "REPLACE_WITH_MAYA_CALLBACK_BASIC_AUTH_USER",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "maya_sandbox_base_url",
      "value": "https://pg-sandbox.paymaya.com",
      "type": "default",
      "enabled": true
    },
    {
      "key": "rrn",
      "value": "RRN-SANDBOX-000001",
      "type": "default",
      "enabled": true
    },
    {
      "key": "paymaya_signature",
      "value": "",
      "type": "default",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment",
  "_postman_exported_using": "ePayPlus"
}
