APP_NAME="INSA POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Product mode: insa | epayplus | auto (resolve from host lists below)
# Laragon ePay Plus project: use APP_PRODUCT=epayplus
# INSA-only local vhost: use APP_PRODUCT=insa
APP_PRODUCT=auto
EPAYPLUS_HOSTS=epayplus.diybizrewards.com,localhost
INSA_HOSTS=insapos.diybizrewards.com
INSA_POS_CASHIER_URL=https://insapos.diybizrewards.com/pos/cashier

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=insa_pos
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Leave unset so HTTP Android WebView shells receive cookies; set true only if the app always uses HTTPS.
# SESSION_SECURE_COOKIE=
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Maya Partner Biller API (Partner Biller — inbound Validate/Post, outbound Callback)
# Testing: docs/MAYA_BILLER_TESTING.md | Postman: postman/ePayPlus-Maya-Biller-Local-Mock.json
MAYA_BILLER_ENABLED=true
MAYA_BILLER_SECRET_KEY=
MAYA_BILLER_CALLBACK_API_KEY=
MAYA_BILLER_SKIP_SIGNATURE=true
MAYA_BILLER_ENVIRONMENT=sandbox
MAYA_BILLER_REQUIRE_VALIDATE_PROOF=true
MAYA_BILLER_SYSTEM_RETAILER_ACCOUNT_ID=EPDEMO001
MAYA_BILLER_SANDBOX_BASE_URL=https://pg-sandbox.paymaya.com
MAYA_BILLER_PRODUCTION_BASE_URL=https://pg.paymaya.com
MAYA_BILLER_CALLBACK_PATH=/partners/v1/billers/transactions/callback
MAYA_BILLER_DEFAULT_CURRENCY=PHP
MAYA_BILLER_HTTP_TIMEOUT=30
MAYA_BILLER_DEFAULT_CONVENIENCE_FEE=0
MAYA_BILLER_DEFAULT_SERVICE_FEE=5
MAYA_BILLER_PUBLIC_BASE_URL=https://epayplus.diybizrewards.com
MAYA_BILLER_VALIDATE_PROOF_TTL=30
MAYA_BILLER_MAINTENANCE=false
